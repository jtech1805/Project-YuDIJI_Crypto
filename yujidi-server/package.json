{
  "name": "yujidi-server",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"tsx src/server.ts\"",
    "start": "tsx src/server.ts",
    "sync:angel-symbols": "tsx src/scripts/sync-angel-symbols.ts",
    "sync:symbols:angel:nse": "tsx src/scripts/sync-angel-symbols.ts --exchanges=NSE --market-types=EQUITY --names=*",
    "sync:symbols:angel:nfo": "tsx src/scripts/sync-angel-symbols.ts --exchanges=NFO --market-types=FNO --names=*",
    "sync:symbols:angel:all": "tsx src/scripts/sync-angel-symbols.ts --exchanges=MCX,NSE,NFO --market-types=COMMODITY,EQUITY,FNO --names=*",
    "symbols:backfill-search": "tsx src/scripts/backfill-symbol-search-fields.ts",
    "test": "node --import tsx --test tests/unit/adapters/ai/*.test.ts tests/unit/services/*.test.ts tests/unit/services/security/*.test.ts tests/unit/integrations/market-data/angel/*.test.ts tests/unit/utils/*.test.ts",
    "test:analyzer": "node --import tsx --test tests/unit/services/analyzer.*.test.ts",
    "typecheck": "tsc --noEmit",
    "arch:circular": "node scripts/check-circular-dependencies.mjs",
    "arch:graph": "npx --no-install depcruise --include-only '^src' --output-type dot src",
    "benchmark:gemini-generation": "tsx scripts/benchmarks/run-gemini-structured-generation-benchmark.ts",
    "benchmark:gemini-embedding": "tsx scripts/benchmarks/run-gemini-embedding-benchmark.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@google/genai": "^2.16.0",
    "axios": "^1.15.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "google-auth-library": "^10.6.2",
    "groq-sdk": "^1.1.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.4.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "madge": "6.0.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
