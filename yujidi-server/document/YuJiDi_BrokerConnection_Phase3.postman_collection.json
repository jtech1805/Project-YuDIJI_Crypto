    {
      "name": "Market Quotes - Angel Phase 4",
      "item": [
        {
          "name": "Find Angel MCX Symbols And Save First Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/monitors/symbols/universal?provider=ANGEL_ONE&exchange=MCX&marketType=COMMODITY&includeBrokerRequired=true&limit=10&q=CRUDEOIL",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "monitors",
                "symbols",
                "universal"
              ],
              "query": [
                {
                  "key": "provider",
                  "value": "ANGEL_ONE"
                },
                {
                  "key": "exchange",
                  "value": "MCX"
                },
                {
                  "key": "marketType",
                  "value": "COMMODITY"
                },
                {
                  "key": "includeBrokerRequired",
                  "value": "true"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "q",
                  "value": "CRUDEOIL"
                }
              ]
            },
            "description": "Finds Angel MCX symbols from the universal symbol registry and saves the first result _id into angelSymbolId. Run Phase 2 sync first if this returns an empty array."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Angel symbol search succeeded', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const symbols = body.data || [];",
                  "pm.test('At least one Angel MCX symbol exists', function () {",
                  "  pm.expect(symbols.length).to.be.greaterThan(0);",
                  "});",
                  "",
                  "if (symbols.length > 0) {",
                  "  const first = symbols[0];",
                  "  const id = first._id || first.id;",
                  "  if (id) pm.collectionVariables.set('angelSymbolId', id);",
                  "  console.log('Saved angelSymbolId:', id, first.symbol || first.displayName);",
                  "}"
                ]
              }
            }
          ]
        },
