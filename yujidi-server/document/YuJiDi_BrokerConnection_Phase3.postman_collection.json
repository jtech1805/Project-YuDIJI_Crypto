    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"name\": \"{{name}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Optional. Use this only if the test user does not already exist. Password must be at least 8 characters."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Register returns success or expected duplicate error', function () {",
                  "  pm.expect([201, 400, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Run this before protected broker connection requests. The test script stores accessToken and refreshToken from Set-Cookie into collection variables."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeded', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const setCookieHeader = pm.response.headers.get('Set-Cookie') || '';",
                  "const accessMatch = setCookieHeader.match(/accessToken=([^;]+)/);",
                  "const refreshMatch = setCookieHeader.match(/refreshToken=([^;]+)/);",
                  "",
                  "if (accessMatch && accessMatch[1]) {",
                  "  pm.collectionVariables.set('accessToken', accessMatch[1]);",
                  "}",
                  "if (refreshMatch && refreshMatch[1]) {",
                  "  pm.collectionVariables.set('refreshToken', refreshMatch[1]);",
                  "}",
                  "",
                  "pm.test('Auth cookies captured into collection variables', function () {",
                  "  pm.expect(pm.collectionVariables.get('accessToken')).to.be.a('string').and.not.empty;",
                  "  pm.expect(pm.collectionVariables.get('refreshToken')).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "accessToken={{accessToken}}; refreshToken={{refreshToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Verifies that the captured auth cookie variables work for protected routes."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Current user loaded', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "accessToken={{accessToken}}; refreshToken={{refreshToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "Refreshes the YuJiDi auth session and captures the new cookies."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Refresh succeeded', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const setCookieHeader = pm.response.headers.get('Set-Cookie') || '';",
                  "const accessMatch = setCookieHeader.match(/accessToken=([^;]+)/);",
                  "const refreshMatch = setCookieHeader.match(/refreshToken=([^;]+)/);",
                  "if (accessMatch && accessMatch[1]) pm.collectionVariables.set('accessToken', accessMatch[1]);",
                  "if (refreshMatch && refreshMatch[1]) pm.collectionVariables.set('refreshToken', refreshMatch[1]);"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "accessToken={{accessToken}}; refreshToken={{refreshToken}}"
