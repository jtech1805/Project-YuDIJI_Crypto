                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('Normalized FULL snapshot is safe', function () {",
                  "  pm.expect(body.data.provider).to.eql('ANGEL_ONE');",
                  "  pm.expect(body.data.mode).to.eql('FULL');",
                  "  pm.expect(body.data.symbolId).to.eql(pm.collectionVariables.get('angelSymbolId'));",
                  "  pm.expect(JSON.stringify(body)).to.not.include('jwtToken');",
                  "  pm.expect(JSON.stringify(body)).to.not.include('refreshToken');",
                  "  pm.expect(JSON.stringify(body)).to.not.include('feedToken');",
                  "  pm.expect(JSON.stringify(body)).to.not.include('apiKey');",
                  "  pm.expect(JSON.stringify(body)).to.not.include('encrypted');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Angel Quote - Variable Mode",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "accessToken={{accessToken}}; refreshToken={{refreshToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/market-quotes/{{angelSymbolId}}?mode={{quoteMode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "market-quotes",
                "{{angelSymbolId}}"
              ],
              "query": [
                {
                  "key": "mode",
                  "value": "{{quoteMode}}"
                }
              ]
            },
            "description": "Uses quoteMode collection variable. Valid values: LTP, OHLC, FULL."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Angel quote with variable mode succeeded', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Variable mode response is safe', function () {",
                  "  pm.expect(body.data.mode).to.eql(pm.collectionVariables.get('quoteMode'));",
                  "  pm.expect(JSON.stringify(body)).to.not.include('encrypted');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Negative Test - Invalid Quote Mode",
          "request": {
            "method": "GET",
