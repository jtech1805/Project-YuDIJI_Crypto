    {
      "name": "Broker Connections - Angel One",
      "item": [
        {
          "name": "Connect Angel Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "accessToken={{accessToken}}; refreshToken={{refreshToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientCode\": \"{{angelClientCode}}\",\n  \"apiKey\": \"{{angelApiKey}}\",\n  \"pin\": \"{{angelPin}}\",\n  \"totp\": \"{{angelTotp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/broker-connections/angel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "broker-connections",
                "angel"
              ]
            },
            "description": "Connects the logged-in YuJiDi user to Angel One. Requires backend env BROKER_CREDENTIAL_ENCRYPTION_KEY, ANGEL_CLIENT_LOCAL_IP, ANGEL_CLIENT_PUBLIC_IP, and ANGEL_MAC_ADDRESS. Use a fresh current TOTP."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Angel connection created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('Response is safe and order placement disabled', function () {",
                  "  pm.expect(body.status).to.eql('success');",
                  "  pm.expect(body.data.broker).to.eql('ANGEL_ONE');",
                  "  pm.expect(body.data.permissions.orderPlacement).to.eql(false);",
                  "  pm.expect(JSON.stringify(body)).to.not.include('encrypted');",
                  "  pm.expect(JSON.stringify(body)).to.not.include(pm.collectionVariables.get('angelApiKey'));",
                  "  pm.expect(JSON.stringify(body)).to.not.include(pm.collectionVariables.get('angelPin'));",
                  "});"
                ]
              }
            }
          ]
        },
